{
  "name": "file-organizer",
  "version": "1.0.0",
  "description": "跨平台桌面文件整理工具",
  "main": "dist-electron/main/main.js",
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--max-old-space-size=4096 chcp 65001 && electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "pack": "electron-builder",
    "dist": "npm run build && electron-builder",
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "seed": "node seeds/seed.js",
    "eval:classify": "node scripts/eval-classification.mjs",
    "eval:classify-run": "npx tsx scripts/run-classification-eval.mjs",
    "bootstrap:clip-prompts": "node scripts/bootstrap-clip-prompts.mjs all",
    "bootstrap:fixtures": "node scripts/bootstrap-classification-fixtures.mjs",
    "download:models": "node scripts/download-classification-models.mjs accuracy_max",
    "dev:auth-api": "npm run dev --prefix backend",
    "init:backend-env": "node scripts/init-backend-env.mjs",
    "check:auth-api": "node scripts/check-auth-api.mjs"
  },
  "keywords": [
    "electron",
    "file-organizer",
    "desktop-app"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "chokidar": "^3.5.3",
    "electron-squirrel-startup": "^1.0.1",
    "exiftool-vendored": "^35.20.0",
    "fs-extra": "^11.2.0",
    "onnxruntime-node": "^1.19.2",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@ant-design/icons": "^5.2.6",
    "@fontsource-variable/geist": "^5.2.9",
    "@radix-ui/react-slot": "^1.2.4",
    "antd": "^5.12.8",
    "class-variance-authority": "^0.7.1",
    "classnames": "^2.3.2",
    "clsx": "^2.1.1",
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.0.6",
    "exifr": "^7.1.3",
    "lucide-react": "^1.16.0",
    "radix-ui": "^1.4.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-icons": "^5.6.0",
    "shadcn": "^4.7.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zustand": "^4.4.7",
    "@electron-forge/cli": "^7.11.1",
    "@electron-forge/maker-deb": "^7.11.1",
    "@electron-forge/maker-rpm": "^7.11.1",
    "@electron-forge/maker-squirrel": "^7.11.1",
    "@electron-forge/maker-zip": "^7.11.1",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.1",
    "@electron-forge/plugin-fuses": "^7.11.1",
    "@electron/fuses": "^1.8.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^20.10.6",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "@vitejs/plugin-react": "^4.2.1",
    "cross-env": "^10.1.0",
    "electron": "^28.1.0",
    "electron-builder": "^26.4.0",
    "electron-vite": "^2.0.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.3.3",
    "vite": "^5.0.10"
  },
  "build": {
    "appId": "com.fileorganizer.app",
    "productName": "FileOrganizer",
    "directories": {
      "output": "release"
    },
    "publish": null,
    "asar": true,
    "compression": "maximum",
    "afterPack": "./scripts/prune-packaged-onnx.mjs",
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "asarUnpack": [
      "node_modules/exiftool-vendored/**/*",
      "node_modules/exiftool-vendored.exe/**/*"
    ],
    "win": {
      "target": [
        "dir"
      ],
      "icon": "build/icon.ico",
      "forceCodeSigning": false
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "build/icon.icns"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build/icon.png"
    }
  }
}
